# ─────────────────────────────────────────────────────────────
#  CumbumValley AgriApp – Environment Configuration
#  Copy this file to .env and adjust values before running.
#  The start.sh script does this automatically on first run.
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=181c432d8942a6153cbb3422f6ca15f3045f539042fc8ae4f20c2240bff3dd0e
JWT_EXPIRES_IN=30d

# ── MongoDB ───────────────────────────────────────────────────
# Docker Compose service name is "mongo" – keep this as-is when using Docker.
# For local bare-metal development, change to: mongodb://127.0.0.1:27017/agri-app
MONGO_URI=mongodb://mongo:27017/agri-app

# ── Frontend (Vite, read at build/dev time) ───────────────────
VITE_API_URL=http://localhost:5000
